# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing & logs
/coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output
/.next/
/out/
.next

# Production databases & runtime sqlite files (keep database empty/clean on git)
/data/*.db*
data/*.db
data/*.db-shm
data/*.db-wal
!data/.gitkeep

# User runtime uploads (never commit user-generated photos and videos to git)
/uploads/photos/*
/uploads/videos/*
!uploads/photos/.gitkeep
!uploads/videos/.gitkeep

# Environment variables & secrets (CRITICAL: NEVER COMMIT API KEYS)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Temporary rendering directories & files
temp_*
/temp_video_render/
/temp_*/
check_*
chk_*

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
/build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# OS Files
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE settings
.vscode/
.idea/

